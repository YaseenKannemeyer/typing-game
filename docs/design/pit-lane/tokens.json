{
  "name": "GRID Pit Lane",
  "status": "proposal-not-imported",
  "version": 1,
  "colors": {
    "background": "#141619",
    "panel": "#202328",
    "raised": "#2B3037",
    "divider": "#464D57",
    "controlBorder": "#7C8591",
    "text": "#F4F2EB",
    "textSecondary": "#B8BDC6",
    "textMuted": "#9CA5B1",
    "accent": "#FFD336",
    "accentHover": "#FFE071",
    "onAccent": "#141619",
    "ticket": "#F4F2EB",
    "onTicket": "#141619",
    "ticketSecondary": "#505761",
    "ticketError": "#B42318",
    "error": "#FF8B82",
    "errorSurface": "#3B2225",
    "success": "#7DDDA3",
    "warning": "#F0B75D",
    "infoGhost": "#8BBEFF"
  },
  "fonts": {
    "display": "Barlow Condensed",
    "displayStatus": "proposed-not-installed",
    "ui": "Geist Variable",
    "mono": "Geist Mono Variable"
  },
  "spacePx": [4, 8, 12, 16, 24, 32, 48, 64],
  "radiusPx": { "control": 2, "panel": 4 },
  "layoutPx": {
    "contentMax": 1280,
    "spectatorMax": 1600,
    "desktopGutter": 24,
    "phoneGutter": 16,
    "header": 64,
    "raceHeader": 56,
    "minimumTarget": 44,
    "primaryControl": 48
  },
  "motionMs": { "fast": 140, "normal": 220, "resultMax": 600 },
  "legacyAliasProposal": {
    "--g-bg": "background",
    "--g-panel": "panel",
    "--g-panel-raised": "raised",
    "--g-border": "divider",
    "--g-text": "text",
    "--g-muted": "textSecondary",
    "--g-subtle": "textMuted",
    "--g-lime": "accent",
    "--g-ink": "onAccent",
    "--g-sage": "ticket",
    "--g-error": "error",
    "--g-error-bg": "errorSurface",
    "--g-blue": "infoGhost",
    "--g-warning": "warning",
    "--g-success": "success",
    "--ui-surface": "panel",
    "--ui-surface-raised": "raised",
    "--ui-edge": "divider",
    "--ui-soft": "textSecondary"
  },
  "notes": [
    "Legacy aliases are a migration bridge, not permission to retain competing hard-coded themes.",
    "Use controlBorder for meaningful input boundaries; divider is decorative only.",
    "Ticket forms require their own dark focus, text and error colors.",
    "Keep medal and livery colors distinct from the principal accent.",
    "Large text and zoom take priority over fixed viewport fit."
  ]
}
