{
  "name": "type-racer",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p shared && tsc -p client --noEmit",
    "bots": "tsx scripts/bots.ts",
    "e2e": "tsx scripts/e2e.ts",
    "build:functions": "node scripts/build-functions.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
