# Copy to .env.local and fill in from Supabase → Project Settings → API Keys
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public site URL (set in Vercel) so invite links get a preview image, e.g. https://grid.example.com
VITE_PUBLIC_URL=
# Cloudflare Turnstile site key (public). Leave empty to disable captcha.
# Enable captcha in Supabase (Auth → Attack Protection) only after this is deployed.
VITE_TURNSTILE_SITE_KEY=
